<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Architecture-parameterised package. build-installer.ps1 supplies:
         -d Version, -d UpgradeCode, -d ExePath, -d InstallDirName, -d ArchKey
       and passes -arch x64|x86 so the MSI template matches the binary.
       Each architecture has its own UpgradeCode so installing one never
       silently uninstalls the other. -->
  <Package Name="Techvision API Checker"
           Manufacturer="Techvision"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Techvision API Checker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="appicon.ico" SourceFile="assets\techvision-api-checker.ico" />
    <Property Id="ARPPRODUCTICON" Value="appicon.ico" />
    <Property Id="ARPCONTACT" Value="Jayasimma D" />

    <!-- The agreement text lives in LICENSE.md; tools/make-license-rtf.ps1 turns it
         into this RTF, and the Mondo dialog set shows it before installing. -->
    <WixVariable Id="WixUILicenseRtf" Value="assets\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\installer-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\installer-dialog.bmp" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallDirName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="$(var.InstallDirName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Application" Title="Techvision API Checker" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <!-- Mondo = licence agreement page, then setup type, folder picker and confirmation.
         WixUI_InstallDir alone would skip the agreement. -->
    <ui:WixUI Id="WixUI_Mondo" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component>
        <File Source="$(var.ExePath)" />
      </Component>
      <Component>
        <File Source="assets\techvision-api-checker.ico" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents" Directory="AppProgramMenuFolder">
      <Component>
        <Shortcut Id="StartMenuShortcut"
                  Name="Techvision API Checker"
                  Target="[INSTALLFOLDER]techvision-api-checker.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="appicon.ico" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Techvision\TechvisionApiChecker\$(var.ArchKey)"
                       Name="start-menu-shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut"
                  Name="Techvision API Checker"
                  Target="[INSTALLFOLDER]techvision-api-checker.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="appicon.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\Techvision\TechvisionApiChecker\$(var.ArchKey)"
                       Name="desktop-shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
